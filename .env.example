# SOCGenie backend AI proxy — SERVER-SIDE ONLY
#
# Copy to .env at the repository root. .env must never be committed.
#
# These values are read by the Node proxy process only. They are NOT Vite
# variables and must never be prefixed with VITE_ — anything VITE_-prefixed is
# inlined into the browser bundle and readable by any visitor.
#
# The proxy runs happily with all of these blank: SOCGenie falls back to the
# deterministic rule-based engine and says so in the UI.

# Which provider to use: "openrouter", "anthropic", or blank for none.
# Blank is a valid, fully working configuration — SOCGenie uses the
# deterministic engine and says so in the UI.
LLM_PROVIDER=

# --- OpenRouter (has a free tier) ---------------------------------------
# Get a key at https://openrouter.ai/keys
# Server-side only. Never appears in a response, a log line, or src/.
OPENROUTER_API_KEY=

# --- Anthropic ----------------------------------------------------------
ANTHROPIC_API_KEY=

# Model identifier. Leave blank to use the provider default:
#   openrouter -> meta-llama/llama-3.3-70b-instruct:free
#   anthropic  -> claude-sonnet-4-6
#
# IMPORTANT: OpenRouter's free model list changes over time. If the proxy logs
# a 404 saying the model was not found, pick any current model with a ":free"
# suffix from https://openrouter.ai/models?q=free and set it here. No code
# change is needed.
#
# Free models are also weaker at emitting strict JSON. When output cannot be
# parsed, SOCGenie falls back to the deterministic engine rather than showing
# anything unreliable.
LLM_MODEL=

# Proxy port. The Vite dev server proxies /api to this.
PORT=8787

# Port the Python ML service (ml/service/app.py) listens on, and the only
# part of its address that is configurable — the host is always 127.0.0.1,
# hardcoded, to avoid turning this into an SSRF sink. Only needed if 8000 is
# already in use on your machine; read this exact variable name when
# starting the service too, e.g. SOCGENIE_ML_PORT=8010 python -m ml.service.app
SOCGENIE_ML_PORT=8000

# Guards
MAX_MESSAGE_CHARS=4000
PROVIDER_TIMEOUT_MS=25000
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000

# --- Phase 11: authentication and origin policy --------------------------
# HMAC key for session tokens. Leave blank for a random per-boot secret
# (sessions then end on restart, which is fine locally).
AUTH_SECRET=

# Token lifetime in seconds.
TOKEN_TTL_SECONDS=28800

# DEMO CREDENTIALS — development only.
# These are NOT identity assurance: each password is shared and already
# appears in the login UI. What they buy is that the ROLE is server-signed and
# cannot be forged by the browser. A real deployment needs an identity
# provider.
#
# The two values MUST differ. roleForEmail() (server/src/auth.ts) picks admin
# vs analyst purely from the email's local part, so if both passwords match,
# that one shared string would unlock admin too. The server enforces this
# itself (server/src/config.ts): if they're ever equal, DEMO_ADMIN_PASSWORD is
# treated as unset and admin demo login is disabled until you fix it — but
# don't rely on that safety net, just keep them different.
#
# If BOTH are blank the server refuses every login (fails closed).
DEMO_ANALYST_PASSWORD=socgenie-analyst-demo
DEMO_ADMIN_PASSWORD=socgenie-admin-demo

# Browser origins permitted to call the API. Never "*" — this API is credentialed.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Stricter budget for LLM calls specifically.
AI_RATE_LIMIT_MAX=8

# Ceiling on an upstream provider response body, in bytes.
MAX_PROVIDER_BYTES=262144

# --- Optional (leave unset unless needed) -------------------------------
# Backend the Vite dev server proxies /api to. Default: http://localhost:8787
# SOCGENIE_API_URL=http://localhost:8787
#
# Directory holding model_card.json and the trained artifacts, read by the
# Python ML service. Default: "models", relative to the directory the service
# is started from (run it from the repository root).
# SOCGENIE_MODELS_DIR=models
